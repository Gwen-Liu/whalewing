filters:
  or:
    - and:
        - 'type == "timeline"'
        - 'timeline_type == "task"'
    - and:
        - 'type == "output"'
        - 'output_type == "task-record"'
properties:
  date:
    displayName: 日期
  actual_date:
    displayName: 日期（早先的记录）
  project:
    displayName: 所属项目
  status:
    displayName: 状态
  updated:
    displayName: 最近更新
views:
  - type: table
    name: 任务记录
    order:
      - file.name
      - date
      - actual_date
      - project
      - status
    sort:
      - property: date
        direction: DESC
  - type: table
    name: 最近任务
    order:
      - file.name
      - project
      - status
    sort:
      - property: updated
        direction: DESC
    limit: 15
